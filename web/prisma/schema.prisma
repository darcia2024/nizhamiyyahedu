// Skema ini dibangun ulang dari PRD (bagian 6.4), karena skema production asli tidak tersedia.
// Database: Postgres di Supabase. DATABASE_URL = koneksi pooler (port 6543, untuk aplikasi),
// DIRECT_URL = koneksi langsung/sesi (port 5432, untuk migrasi).
// Enum disimpan sebagai String; nilai sah didefinisikan di src/lib/constants.ts.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" dipakai fungsi Node.js di Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      String   @default("STUDENT") // STUDENT | TEACHER | ADMIN
  whatsapp  String?
  createdAt DateTime @default(now())

  teacherProfile TeacherProfile?
  enrollments    Enrollment[]
  orders         Order[]
  progress       LessonProgress[]
  lessonNotes    LessonNote[]
  certificates   Certificate[]
  notes          Note[]
}

model TeacherProfile {
  id          String  @id @default(cuid())
  userId      String? @unique
  user        User?   @relation(fields: [userId], references: [id])
  displayName String
  bio         String  @default("")
  alumni      String?
  sanad       String?
  photoUrl    String?
  showOnHome  Boolean @default(true)

  courses Course[]
}

model Course {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  titleAr         String?
  description     String          @default("")
  field           String // NAHWU | SHARAF | FIQIH | AQIDAH | HADITS | TAFSIR | LAINNYA
  level           String // ULA | WUSTHA | ULYA
  status          String          @default("DRAFT") // DRAFT | PUBLISHED
  priceRupiah     Int             @default(0)
  sortOrder       Int             @default(0)
  bundleCourseIds String? // JSON: [courseId]; terisi = paket bundling yang membuka kursus-kursus ini
  coverUrl        String? // foto kitab untuk sampul kartu
  archivedAt      DateTime?
  teacherId       String?
  teacher         TeacherProfile? @relation(fields: [teacherId], references: [id])
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lessons      Lesson[]
  enrollments  Enrollment[]
  orders       Order[]
  userNotes    Note[]
  certificates Certificate[]
  vouchers     Voucher[]

  @@index([status, archivedAt])
}

model Lesson {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  title         String
  position      Int
  status        String   @default("DRAFT") // DRAFT | PUBLISHED
  isFreePreview Boolean  @default(false)
  durationMin   Int?
  videoUrl      String?
  matan         String? // JSON: [{ ar: string, id: string }]
  notesMd       String?
  createdAt     DateTime @default(now())

  progress LessonProgress[]
  notes    LessonNote[]

  @@unique([courseId, position])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  status    String   @default("ACTIVE") // ACTIVE | REVOKED
  source    String   @default("FREE") // FREE | PAID | MANUAL
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id])
  completedAt  DateTime?
  lastOpenedAt DateTime  @default(now())

  @@id([userId, lessonId])
}

/// Catatan pribadi siswa per pelajaran (satu catatan per siswa per pelajaran).
model LessonNote {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  body      String
  pinned    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@id([userId, lessonId])
  @@index([userId, updatedAt])
}

/// Catatan bebas milik pengguna (aplikasi catatan di dashboard). Catatan per pelajaran tetap di LessonNote;
/// keduanya tampil bersama di satu daftar. courseId opsional untuk mengelompokkan per kelas.
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  body      String   @default("")
  pinned    Boolean  @default(false)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pinned, updatedAt])
}

model Order {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id])
  amount    Int
  status    String    @default("PENDING") // PENDING | PAID | FAILED | EXPIRED | CANCELLED
  whatsapp  String
  mayarId   String?
  payUrl    String?
  expiresAt DateTime
  paidAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())
  // Terisi bila memakai voucher: amount sudah setelah diskon, originalAmount harga sebelum diskon.
  voucherId      String?
  voucher        Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCode    String?
  originalAmount Int?

  @@index([userId, courseId, status])
  @@index([status, expiresAt])
  @@index([voucherId])
}

/// Kode diskon. courseIds (JSON) dan courseId kosong = berlaku semua kursus; allowedEmails kosong = siapa saja (pisah koma).
model Voucher {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String    @default("")
  discountType  String    @default("PERCENT") // PERCENT | NOMINAL
  percent       Int // dipakai bila discountType PERCENT
  amountOff     Int? // rupiah, dipakai bila discountType NOMINAL
  minPurchase   Int?
  singleUse     Boolean   @default(false) // true = tiap akun hanya bisa memakai kode ini sekali
  startsAt      DateTime?
  courseIds     String? // JSON: [courseId]; kursus yang boleh memakai voucher ini
  courseId      String?
  course        Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  allowedEmails String?
  maxUses       Int?
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  orders Order[]
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String?
  action     String
  targetType String
  targetId   String
  before     String?
  after      String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model SiteContent {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Riwayat setiap penyimpanan SiteContent (beranda, FAQ, kontak) agar bisa dipulihkan.
model SiteContentVersion {
  id        String   @id @default(cuid())
  key       String
  version   Int
  value     String // JSON
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([key, version])
  @@index([key, createdAt])
}

model LegalDocument {
  slug        String
  version     Int
  title       String
  bodyMd      String
  publishedAt DateTime?
  updatedBy   String?

  @@id([slug, version])
}

model Event {
  id        String   @id @default(cuid())
  name      String // course_view | checkout_start | order_paid
  courseId  String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// Sertifikat penyelesaian kelas: terbit sekali per siswa per kelas saat semua pelajaran selesai.
/// Nama dan judul disalin (snapshot) supaya sertifikat tetap sama walau profil atau judul kelas berubah.
model Certificate {
  id            String    @id @default(cuid())
  code          String    @unique // mis. NZ-2026-3F9A12CC, dicetak di sertifikat dan dipakai di tautan verifikasi
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  holderName    String
  courseTitle   String
  courseTitleAr String?
  teacherName   String?
  lessonCount   Int
  totalMin      Int       @default(0)
  finishedAt    DateTime
  issuedAt      DateTime  @default(now())
  revokedAt     DateTime? // dicabut admin bila perlu; halaman verifikasi lalu menolak

  @@unique([userId, courseId])
}
