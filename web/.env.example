# Salin menjadi .env lalu isi. Semua nilai ini rahasia kecuali APP_URL.
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3200"
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Hanya untuk lokal: aktifkan login uji tanpa Google (JANGAN di production).
DEV_LOGIN="1"
MAYAR_API_KEY=""
MAYAR_WEBHOOK_TOKEN="ganti-token-webhook"
MAYAR_API_BASE="https://api.mayar.id/hl/v1"
CRON_SECRET="ganti-cron-secret"
MONITOR_TOKEN="ganti-monitor-token"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
VIDEO_HOST_ALLOWLIST=""
