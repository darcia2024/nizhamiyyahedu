# Salin menjadi .env lalu isi. Semua nilai ini rahasia kecuali APP_URL.
# Production (Vercel) diisi lewat: .\scripts\setup-production.ps1

# Supabase > Project Settings > Database > Connection string.
# DATABASE_URL: Transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=1
# DIRECT_URL: Session pooler / direct (port 5432), dipakai migrasi.
DATABASE_URL=""
DIRECT_URL=""
# Opsional: database Postgres terpisah khusus tes integrasi (isinya boleh dihapus kapan saja).
TEST_DATABASE_URL=""

# Supabase > Project Settings > API. Tanpa ini, foto unggahan disimpan di folder uploads/ lokal.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

APP_URL="http://localhost:3200"
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email Google yang otomatis jadi superadmin saat login (pisahkan koma).
ADMIN_EMAILS=""
# Hanya untuk lokal: aktifkan login uji tanpa Google (JANGAN di production).
DEV_LOGIN="1"
MAYAR_API_KEY=""
MAYAR_WEBHOOK_TOKEN="ganti-token-webhook"
MAYAR_API_BASE="https://api.mayar.id/hl/v1"
CRON_SECRET="ganti-cron-secret"
MONITOR_TOKEN="ganti-monitor-token"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
VIDEO_HOST_ALLOWLIST=""
