{
  "name": "nizhamiyyah-edu-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "prisma generate && next build",
    "build:demo": "prisma generate && tsx scripts/build-demo-db.ts && next build",
    "vercel-build": "npm run build:demo",
    "start": "next start -p 3200",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:prepare": "tsx scripts/prepare-db.ts",
    "admin:create": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.31"
  }
}
