{
  "regions": ["dub1"],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.belajarditimurtengah.com" }],
      "destination": "https://belajarditimurtengah.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "nizhamiyyahedu.vercel.app" }],
      "destination": "https://belajarditimurtengah.com/:path",
      "permanent": true
    }
  ]
}
